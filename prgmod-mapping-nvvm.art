
static warp_size:i32 = 32;

fn nvvm_thread_intrinsics() = GroupIntrinsics {
};

struct WMMA_OP[T] {
	wmma: Op[(), WMMA],
}

implicit = WMMA_OP[f64] { wmma = Op[(), WMMA]::Generic };

//static tile_size_k = 16;

implicit = WMMA_OP[f16] {
	wmma = Op[(), WMMA]::Fn(@|| nvvm_create_wmma_f16(tile_size_k))
};
implicit = WMMA_OP[f32] {
	wmma = Op[(), WMMA]::Fn(@|| nvvm_create_wmma_f32(tile_size_k))
};

fn nvvm_warp_intrinsics(tile_size_k: i32, implicit wmma_op : WMMA_OP[c_element_type]) = GroupIntrinsics {
	barrier_any = Op[Accessor[u8],  u8]::Fn(nvvm_warp_barrier_any),
	//shuffle_i32 = Op[   (i32,i32), i32]::Fn(nvvm_warp_shuffle_i32)
	//wmma = Op[   (), WMMA]::Fn(@|| nvvm_create_wmma(tile_size_k))
        wmma = wmma_op.wmma
};

fn nvvm_block_intrinsics() = GroupIntrinsics {
	barrier_any = Op[Accessor[u8], u8]::Fn(nvvm_block_barrier_any)
};


fn @make_nvvm_thread(_idx: i32) -> Group {
	Group {
		size = 1,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| {
			// cuda_threadfence()
		},
		subgroups = @|body| @|| {
			let idx = 0;
			let thread = make_nvvm_thread(idx);
			@body(idx, thread)
		},
		num_subgroups = 1,
		specific = GroupType::Thread,
		intrinsics = nvvm_thread_intrinsics()
	}
}

fn @nvvm_warp_barrier_any(pred:Accessor[u8]) -> u8 {
	let tidx = nvvm_laneid() as i32;
	let mut result:bool = false;
	for i in range_step(tidx, pred.len(), warp_size) {
		let val = i < pred.len() && pred.get(i) != 0;
		result |= nvvm_warp_sync_any(0xFFFFFFFF, val)
		//cuda_warp_sync_any(0xFFFFFFFF, pred.get(tidx) as i32) as u8
	}
	if result { 1 } else { 0 }
}


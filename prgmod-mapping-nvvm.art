// TODO: slice a warp into sub warps

fn @make_nvvm_warp(_idx: i32, _num_warps_per_block: i32) -> Group {
	Group {
		size = warp_size,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| { nvvm_warp_sync(0xFFFFFFFF) },
		subgroups = @|body| @|| {
			let idx = nvvm_laneid() as i32;
			let thread = make_nvvm_thread(idx);
			@body(idx, thread)
		},
		num_subgroups = warp_size,
		specific = GroupType::NVVMWarp,
		intrinsics = GroupIntrinsics {
			barrier_any = Op[Accessor[u8],  u8]::Fn(nvvm_warp_barrier_any),
			//shuffle_i32 = Op[   (i32,i32), i32]::Fn(nvvm_warp_shuffle_i32)
		}
	}
}

fn @nvvm_block_barrier_any(pred:Accessor[u8]) -> u8 {
	let tidx = nvvm_read_ptx_sreg_tid_x();
	let mut result:u8 = 0;
	for i in range_step(tidx, pred.len(), warp_size) {
		let val = if i < pred.len() { pred.get(i) } else { 0 };
		result |= nvvm_block_sync_any(val as i32) as u8
	}
	result
}

fn @make_nvvm_block(_idx: i32, block_size: i32) -> Group {
	let num_warps_per_block = (block_size + warp_size - 1) / warp_size;

	Group {
		size = block_size,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| { nvvm_block_sync() },
		subgroups = @|body| @|| {
			let idx = nvvm_read_ptx_sreg_tid_x() / warp_size;
			let warp = make_nvvm_warp(idx, num_warps_per_block);
			@body(idx, warp)
		},
		num_subgroups = num_warps_per_block,
		specific = GroupType::NVVMBlock,
		intrinsics = GroupIntrinsics {
			barrier_any = Op[Accessor[u8], u8]::Fn(nvvm_block_barrier_any)
		}
	}
}


fn @make_nvvm_group(body: fn(Group)->()) = @|acc: Accelerator, grid_size: i32, block_size: i32, accum_buffer_size: i32| {

	let g = ( grid_size, 1, 1);
	let b = (block_size, 1, 1);

	let num_blocks = (grid_size + block_size - 1) / block_size;

	//let mut total:i32 = 0;

	let buffer = if accum_buffer_size > 0 {
		acc.alloc(accum_buffer_size as i64)
	} else {
		Buffer { size = 0, data = bitcast[&mut [i8]](0), device = 0 }
	};

	for _ in acc.exec(g, b) {
		let mut buffer_offset:i32 = 0;

		let group = Group {
			size = grid_size,
			subgroups = @|body| @|| {
				let idx = nvvm_read_ptx_sreg_ctaid_x();
				let block = make_nvvm_block(idx, block_size);
				@body(idx, block)
			},
			alloc = @|size| {
				let ptr = bitcast[&mut[u8]](&buffer.data(buffer_offset));
				buffer_offset += size;
				ptr
			},
			barrier = @|| { /* acc.sync() */ },
			num_subgroups = num_blocks,
			specific = GroupType::NVVMGrid(block_size),
			intrinsics = GroupIntrinsics { }
		};

		body(group)
	}
	
	release(buffer);
};


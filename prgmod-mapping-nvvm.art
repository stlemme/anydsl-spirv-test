fn @nvvm_pred(b: bool) -> i32 {
	if b { 1 } else { 0 }
}

type SubGroup = Group;

fn @subgroups(body: fn(i32, SubGroup)->()) -> fn(Group)->() {
	@|group| {

		let (idx, subgroup) = match (group.specific) {
			GroupType::NVVMGrid(block_size) => {
				let idx = nvvm_read_ptx_sreg_ctaid_x();
				let num_warps_per_block = (block_size + warp_size - 1) / warp_size;
				let block = Group { size = block_size,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| { nvvm_block_sync() },
					subgroups = @|_body| @|| {

					},
					num_subgroups = num_warps_per_block, specific = GroupType::NVVMBlock,
					intrinsics = GroupIntrinsics {
						//barrier_any = Op[Accessor[u8], u8]::Fn(nvvm_block_barrier_any)
					}
				};

				(idx, block)
			},

			GroupType::NVVMBlock => {
				let idx = nvvm_read_ptx_sreg_tid_x() / warp_size;
				let tile_size_k = 16;
				let warp = Group { size = warp_size,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| nvvm_warp_sync(0xFFFFFFFF),
					subgroups = @|_body| @|| {

					},
					num_subgroups = warp_size, specific = GroupType::NVVMWarp,
					intrinsics = GroupIntrinsics {
						//barrier_any = Op[Accessor[u8], u8]::Fn(cuda_warp_barrier_any),
						//shuffle_i32 = Op[   (i32,i32), i32]::Fn(cuda_warp_shuffle_i32),
						wmma = Op[   (), WMMA]::Fn(|| nvvm_create_wmma(tile_size_k))
					}
				};

				(idx, warp)
			},

			GroupType::NVVMWarp => {
				let idx = nvvm_laneid() as i32;
				let thread = Group { size = 1,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| {
						// cuda_threadfence()
					},
					subgroups = @|_body| @|| {

					},
					num_subgroups = 1, specific = GroupType::NVVMThread, intrinsics = GroupIntrinsics { } };

				(idx, thread)
			},

			_ => {
				(0, Group { size = 1,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| { },
					subgroups = @|_body| @|| {

					},
					num_subgroups = 1, specific = GroupType::NVVMThread, intrinsics = GroupIntrinsics { } })
			}
		};

		body(idx, subgroup)

		//let subgroup_scope = group.subgroups(@|idx, subgroup| @body(idx, *subgroup));
		//subgroup_scope()
	}
}

fn @shared_mem[T](body: fn(Accessor[T])->()) -> fn(Group, i32)->() {

	@|group, size| {
		pe_info("shared_mem[T]() - group.size", group.size);
		pe_info("shared_mem[T]() - size", size);

		// TODO: pass down topology information
		let num_warps_per_block = 4; // (block_size + warp_size - 1) / warp_size;

		let array = match (group.specific) {
			GroupType::NVVMGrid(_block_size) => {
				let size_type = sizeof[T]() as i32;
				let mem_size = size * if size_type > 1 { size_type } else { 1 };
				pe_info("shared_mem[T]() - alloc_cuda()", mem_size);
				let mem = group.alloc(mem_size);
				let ptr = bitcast[&mut[T]](mem);

				Accessor[T] {
					get = @|i| ptr(i),
					set = @|i, val| { ptr(i) = val },
					len = @|| size
				}
			},

			GroupType::NVVMBlock => {
				let mem_size = size;
				pe_info("shared_mem[T]() - reserve_shared[T]()", mem_size);
				let ptr = reserve_shared[T](mem_size);
				//let ptr = bitcast[&mut addrspace(3)[T]](mem);

				Accessor[T] {
					get = @|i| ptr(i),
					set = @|i, val| { ptr(i) = val },
					len = @|| size
				}
			},

			GroupType::NVVMWarp => {
				let mem_size = num_warps_per_block * size;
				pe_info("shared_mem[T]() - reserve_shared[T]()", mem_size);
				let ptr = reserve_shared[T](mem_size);
				//let ptr = bitcast[&mut addrspace(3)[T]](mem);

				// TODO: may use bitmask for offset computation
				let idx = nvvm_read_ptx_sreg_tid_x() / warp_size;
				let offset = idx * warp_size;

				Accessor[T] {
					get = @|i| ptr(offset + i),
					set = @|i, val| { ptr(offset + i) = val },
					len = @|| size
				}

			},

			_ => {
				let mut value:T;

				Accessor[T] {
					get = @|_| value,
					set = @|_, val| { value = val },
					len = @|| 1
				}
			}
		};

		body(array)
	}
}

type a_element_type = f16;
type b_element_type = f16;
type c_element_type = f16;

type f16x2 = simd[f16 * 2];

type nvvm_acc_datatype = (f16x2, f16x2, f16x2, f16x2);
type nvvm_mat_datatype = (f16x2, f16x2, f16x2, f16x2, f16x2, f16x2, f16x2, f16x2);

fn @nvvm_wmma_expand (
	a_fragment : nvvm_mat_datatype,
	b_fragment : nvvm_mat_datatype,
	c_fragment : nvvm_acc_datatype,
	a_mode : AddrMode, b_mode : AddrMode
) -> nvvm_acc_datatype {
    let (a1, a2, a3, a4, a5, a6, a7, a8) = a_fragment;
    let (b1, b2, b3, b4, b5, b6, b7, b8) = b_fragment;
    let (c1, c2, c3, c4) = c_fragment;

    match (a_mode, b_mode) {
        (AddrMode::RowMajor, AddrMode::RowMajor) =>
            nvvm_wmma_row_row(a1, a2, a3, a4, a5, a6, a7, a8, b1, b2, b3, b4, b5, b6, b7, b8, c1, c2, c3, c4),
        (AddrMode::ColMajor, AddrMode::RowMajor) =>
            nvvm_wmma_col_row(a1, a2, a3, a4, a5, a6, a7, a8, b1, b2, b3, b4, b5, b6, b7, b8, c1, c2, c3, c4),
        (AddrMode::RowMajor, AddrMode::ColMajor) =>
            nvvm_wmma_row_col(a1, a2, a3, a4, a5, a6, a7, a8, b1, b2, b3, b4, b5, b6, b7, b8, c1, c2, c3, c4),
        (AddrMode::ColMajor, AddrMode::ColMajor) =>
            nvvm_wmma_col_col(a1, a2, a3, a4, a5, a6, a7, a8, b1, b2, b3, b4, b5, b6, b7, b8, c1, c2, c3, c4)
    }
}

fn @nvvm_wmma_load_a_expand(fragment_tensor : Tensor[a_element_type]) -> nvvm_mat_datatype {
    let cuda_data = bitcast[&i8](fragment_tensor.data);

    match fragment_tensor.addr_mode {
        AddrMode::RowMajor =>
            if (fragment_tensor.stride > 16) {
                nvvm_wmma_load_a_row_stride(cuda_data, fragment_tensor.stride)
            } else {
                nvvm_wmma_load_a_row(cuda_data)
            },
        AddrMode::ColMajor =>
            if (fragment_tensor.stride > 16) {
                nvvm_wmma_load_a_col_stride(cuda_data, fragment_tensor.stride)
            } else {
                nvvm_wmma_load_a_col(cuda_data)
            }
    }
}

fn @nvvm_wmma_load_b_expand(fragment_tensor : Tensor[b_element_type]) -> nvvm_mat_datatype {
    let cuda_data = bitcast[&i8](fragment_tensor.data);

    match fragment_tensor.addr_mode {
        AddrMode::RowMajor =>
            if (fragment_tensor.stride > 16) {
                nvvm_wmma_load_b_row_stride(cuda_data, fragment_tensor.stride)
            } else {
                nvvm_wmma_load_b_row(cuda_data)
            },
        AddrMode::ColMajor =>
            if (fragment_tensor.stride > 16) {
                nvvm_wmma_load_b_col_stride(cuda_data, fragment_tensor.stride)
            } else {
                nvvm_wmma_load_b_col(cuda_data)
            }
    }
}

fn @nvvm_wmma_load_c_expand(fragment_tensor : Tensor[c_element_type]) -> nvvm_acc_datatype {
    let cuda_data = bitcast[&i8](fragment_tensor.data);

    match fragment_tensor.addr_mode {
        AddrMode::RowMajor =>
            if (fragment_tensor.stride > 16) {
                nvvm_wmma_load_c_row_stride(cuda_data, fragment_tensor.stride)
            } else {
                nvvm_wmma_load_c_row(cuda_data)
            },
        AddrMode::ColMajor =>
            if (fragment_tensor.stride > 16) {
                nvvm_wmma_load_c_col_stride(cuda_data, fragment_tensor.stride)
            } else {
                nvvm_wmma_load_c_col(cuda_data)
            }
    }
}

fn @nvvm_wmma_store_d_expand (d_fragment_tensor : Tensor[c_element_type], acc_fragment : nvvm_acc_datatype) -> () {
    let d_cuda = bitcast[&mut i8](d_fragment_tensor.data);
    let (acc1, acc2, acc3, acc4) = acc_fragment;

    match d_fragment_tensor.addr_mode {
        AddrMode::RowMajor =>
            if (d_fragment_tensor.stride > 16) {
                nvvm_wmma_store_d_row_stride(d_cuda, acc1, acc2, acc3, acc4, d_fragment_tensor.stride);
            } else {
                nvvm_wmma_store_d_row(d_cuda, acc1, acc2, acc3, acc4);
            },
        AddrMode::ColMajor =>
            if (d_fragment_tensor.stride > 16) {
                nvvm_wmma_store_d_col_stride(d_cuda, acc1, acc2, acc3, acc4, d_fragment_tensor.stride);
            } else {
                nvvm_wmma_store_d_col(d_cuda, acc1, acc2, acc3, acc4);
            }
    }
}

fn @nvvm_create_wmma(tile_size_k: i32) -> WMMA {
    let mut t_a : nvvm_mat_datatype;
    let mut t_b : nvvm_mat_datatype;
    let mut acc : nvvm_acc_datatype;

    let mut m_a : AddrMode;
    let mut m_b : AddrMode;

	// TODO: this support f16 only / need to map different load&store for f32 support
    WMMA {
        tile_size_k = tile_size_k,
             load_a = @|a| { t_a = nvvm_wmma_load_a_expand(a); m_a = a.addr_mode; },
             load_b = @|b| { t_b = nvvm_wmma_load_b_expand(b); m_b = b.addr_mode; },
             load_c = @|c| { acc = nvvm_wmma_load_c_expand(c); },
               wmma = @||  { acc = nvvm_wmma_expand(t_a, t_b, acc, m_a, m_b); },
            store_d = @|d| { nvvm_wmma_store_d_expand(d, acc); },
    }
}

static warp_size:i32 = 32;


fn @make_nvvm_thread(_idx: i32) -> Group {
	Group {
		size = 1,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| {
			// cuda_threadfence()
		},
		subgroups = @|body| @|| {
			let idx = 0;
			let thread = make_nvvm_thread(idx);
			@body(idx, thread)
		},
		num_subgroups = 1,
		specific = GroupType::NVVMThread,
		intrinsics = GroupIntrinsics { }
	}
}

fn @nvvm_warp_barrier_any(pred:Accessor[u8]) -> u8 {
	let tidx = nvvm_laneid() as i32;
	let mut result:bool = false;
	for i in range_step(tidx, pred.len(), warp_size) {
		let val = i < pred.len() && pred.get(i) != 0;
		result |= nvvm_warp_sync_any(0xFFFFFFFF, val)
		//cuda_warp_sync_any(0xFFFFFFFF, pred.get(tidx) as i32) as u8
	}
	if result { 1 } else { 0 }
}


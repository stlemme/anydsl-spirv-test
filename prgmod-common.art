
enum GroupType {
	Grid,
	Block,
	Warp,
	Thread,

	ThreadPool,
	SIMDLane
}

/*
struct CUDAGrid   { platform: i32, block_size: i32 }
struct CUDABlock  { platform: i32 }
struct CUDAWarp   { platform: i32 }
struct CUDAThread { platform: i32 }
*/

enum Op[S, T] {
	Fn(fn(S)->T),
	Generic
}

type a_element_type = f16;
type b_element_type = f16;
type c_element_type = f16;

struct WMMA {
    tile_size_k: i32,
    load_a: fn(Tensor[a_element_type]) -> (),
    load_b: fn(Tensor[b_element_type]) -> (),
    load_c: fn(Tensor[c_element_type]) -> (),
    wmma: fn() -> (),
    store_d: fn(Tensor[c_element_type]) -> (),
}

struct GroupIntrinsics {
	barrier_any: Op[Accessor[u8],   u8] = Op[Accessor[u8],   u8]::Generic,
	shuffle_i32: Op[   (i32,i32),  i32] = Op[   (i32,i32),  i32]::Generic,
	wmma:        Op[          (), WMMA] = Op[          (), WMMA]::Generic,
	get_clock:   Op[          (),  i64] = Op[          (),  i64]::Generic,
}

struct Group {
	size: i32,										// total num threads
	subgroups: fn(fn(i32, &Group)->()) -> fn()->(),	// split group into subgroups according to hardware topology
	num_subgroups: i32,								// total num subgroups
	alloc: fn(i32) -> &mut[u8],						// allocate/reserve memory
	barrier: fn() -> (),
	specific: GroupType,
	intrinsics: GroupIntrinsics
}

type SubGroup = Group;

fn @subgroups(body: fn(i32, SubGroup)->()) -> fn(Group)->() {
	@|group| {
		let subgroup_scope = group.subgroups(@|idx, subgroup| @body(idx, *subgroup));
		subgroup_scope()
	}
}

struct Device[P] {
	platform: P,
	device_id: i32,
	alloc: fn(i64) -> Buffer,
	root: fn() -> Group
}

fn @make_group[PLATFORM](device: Device[PLATFORM]) {

	let accum_buffer_size = 0;

	//let mut total:i32 = 0;

	let buffer = if accum_buffer_size > 0 {
		device.alloc(accum_buffer_size as i64)
	} else {
		Buffer { size = 0, data = bitcast[&mut [i8]](0), device = 0 }
	};

	//let device_name = runtime_device_name(device.device_id);
	//print_string(device_name);
	//print_char('\n');

	device.root()

	//release(buffer);
}


struct Accessor[T] {
	get: fn(i32) -> T,
	set: fn(i32, T) -> (),
	//set: fn(i32, T) -> () = @|_, _| { },
	len: fn() -> i32
}

fn @make_array_from_buffer[T](buffer: Buffer) -> Accessor[T] {
    let ptr = bitcast[&mut [T]](buffer.data);
    let num = buffer.size / sizeof[T]();

    Accessor[T] {
		get = @|i| {
			ptr(i)
		},
		set = @|i, val| {
			ptr(i) = val;
		},
		len = || num as i32
	}
}

fn @make_partition[T](array: Accessor[T], idx: i32, _group: Group, subgroup: Group) -> Accessor[T] {
	let offset = idx * subgroup.size;

	Accessor[T] {
		get = @|i| {
			array.get(offset + i)
		},
		set = @|i, val| {
			array.set(offset + i, val)
		}, 
		len = || subgroup.size
	}
}

enum AddrMode {
    RowMajor,
    ColMajor
}

struct Tensor[T] {
    data : &mut [T],
    x_dim : i32,
    y_dim : i32,
    addr_mode : AddrMode,
    stride : i32 //row to row offset for this matrix.
}

fn @addr_tensor[T] (x : i32, y : i32, t : Tensor[T]) = match t.addr_mode {
    AddrMode::RowMajor => x + y * t.stride,
    AddrMode::ColMajor => x * t.stride + y
};

fn @sub_tensor[T](t : Tensor[T], x0 : i32, y0 : i32, xs : i32, ys : i32) =
    Tensor[T] {data = bitcast [&mut [T]](&t.data(addr_tensor[T](x0, y0, t))),
                x_dim = xs,
                y_dim = ys,
                addr_mode = t.addr_mode,
                stride = t.stride
              };

fn @tensor_read[V, T](x: i32, y: i32, t: Tensor[T], implicit convert: Convert[T, V]) -> V {
    let value = t.data(addr_tensor(x, y, t));
    convert.apply(value)
}

fn @tensor_write[V, T](x: i32, y: i32, t: Tensor[T], value: V, implicit convert: Convert[V, T]) -> () {
    t.data(addr_tensor(x, y, t)) = convert.apply(value);
}


fn @pick_single_thread(body: fn(i32, SubGroup)->()) -> fn(Group)->() {
	@|group| {
		if group.size > 1 {
			for idx, subgroup in subgroups(group) {
				if idx == 0 {
					pick_single_thread(body)(subgroup)
				}
			}
		} else {
			@body(0, group)
		}
	}
}

fn @each_thread(body: fn(i32, SubGroup)->()) -> fn(Group)->() {

	fn @(?group.size) inner_loop(offset: i32, group: Group)->() {
		if group.size > 1 {
			for idx, subgroup in subgroups(group) {
				// TODO: this assumes equally sized subgroups
				// TODO: this may break in multi-device and heterogenous setups
				inner_loop(offset + idx*subgroup.size, subgroup)
			}
		} else {
			@body(offset, group)
		}
	}

	@|group| {
		inner_loop(0, group)
	}

}


#[import(cc = "builtin", name = "compare")]
fn intrinsic_compare[A](&A, &A) -> bool;

/*
enum  MyEnum { A, B, C }
struct MyType { x: MyEnum }

fn @test_match(value: MyType, specific: MyEnum) -> i32 {

	//match value.x {
	//	specific => 42,
		//_ => 23
	//}

	if intrinsic_compare[MyEnum](value.x, specific) {
		42
	} else {
		23
	}
}
*/

fn @specific_subgroups(body: fn(i32, SubGroup)->()) -> fn(Group, GroupType)->() {

	fn @(?group.specific & ?group.size) inner_loop(offset: i32, group: Group, groupType: GroupType)->() {

		if intrinsic_compare[GroupType](group.specific, groupType) {

			@body(offset, group)

		} else if group.size > 1 {
			for idx, subgroup in subgroups(group) {
				inner_loop(offset + idx, subgroup, groupType)
			}
		} else {
			// raise compiler error
		}
	}

	@|group, groupType| {
		inner_loop(0, group, groupType)
	}

}


fn @each_element_in_domain[T](body: fn(i32)->()) -> fn(Accessor[T], Group)->() {
	@|array, group| {
		for idx, _thread in each_thread(group) {
			let i = idx;
			let n = array.len();
			// each thread may process multiple work items
			for j in range_step(i, n, group.size) {
				@body(j)
			}
		}
	}
}


static mut total_kernel_timing = 0:i64;
static mut total_cpu_timing = 0:i64;

fn @benchmark_wrapper(get_time: fn() -> i64, num_iter: i32, body: fn() -> (), sync: fn() -> ()) -> i64 {
    let times_buf = alloc_cpu(num_iter as i64 * sizeof[i64]());
    let times = bitcast[&mut[i64]](times_buf.data);
    sync();
    for i in range(0, num_iter) {
        let start = get_time();
        body();
        sync();
        times(i) = get_time() - start;
    }
    sort(num_iter, times, |a: i64, b: i64| a > b);
    let median = times(num_iter/2);
    print_string("Timing: ");
    print_f64(times(0) as f64 / 1000.0);
    print_string(" | ");
    print_f64(median as f64 / 1000.0);
    print_string(" | ");
    print_f64(times(num_iter-1) as f64 / 1000.0);
    print_string(" (minimum | median(");
    print_i32(num_iter);
    print_string(") | maximum) ms\n");
    release(times_buf);
    median
}

//static iter_acc =  7;
//static iter_cpu = 27;
fn @benchmark(body: fn() -> ()) = @|group: Group, num_iter: i32| total_kernel_timing += benchmark_wrapper(
	match group.intrinsics.get_clock {
		Op[(), i64]::Fn(func) => @|| func(),
		_ => { @|| { 0 } }
	},
	num_iter,
	body,
	group.barrier);
//fn @benchmark_cpu(body: fn() -> ()) = @||                 total_cpu_timing    += benchmark(get_micro_time,  iter_cpu, body, @|| {});

fn print_total_timing() -> () {
    print_string("Total timing for cpu / kernel: ");
    print_f64(total_cpu_timing as f64 / 1000.0);
    print_string(" / ");
    print_f64(total_kernel_timing as f64 / 1000.0);
    print_string(" ms\n")
}

fn @(?num) sort[T](num: i32, arr: &mut[T], cmp: fn(T, T)->bool) -> () {
    // insertion sort
    for i in range(1, num) {
        let x = arr(i);
        let mut j = i;
        while j >  0 && cmp(arr(j-1), x) {
            arr(j) = arr(j-1);
            j = j - 1;
        }
        arr(j) = x;
    }
}

fn @ze_block_barrier_any(pred:Accessor[u8]) -> u8 {
	let tidx = nvvm_read_ptx_sreg_tid_x();
	let mut result:u8 = 0;
	for i in range_step(tidx, pred.len(), warp_size) {
		let val = if i < pred.len() { pred.get(i) } else { 0 };
		result |= nvvm_block_sync_any(val as i32) as u8
	}
	result
}
*/

fn @make_ze_block(_idx: i32, block_size: i32) -> Group {
	let num_warps_per_block = (block_size + ze_warp_size - 1) / ze_warp_size;

	Group {
		size = block_size,
		alloc = @|size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| { /* nvvm_block_sync() */ },
		subgroups = @|body| @|| {
			let idx = spv_levelzero_get_local_id()(0) as i32 / ze_warp_size;
			let warp = make_ze_warp(idx, num_warps_per_block);
			@body(idx, warp)
		},
		num_subgroups = num_warps_per_block,
		specific = GroupType::Block,
		intrinsics = ze_block_intrinsics()
	}
}

struct LevelZero {
	device_id: i32,
	grid_size: fn(i32) -> (),
	block_size: fn(i32) -> (),
	warps_per_block: fn(i32) -> ()
}

fn levelzero_device(idx: i32) -> Device[LevelZero] {
	let acc = levelzero_accelerator(idx);

	let mut grid_size = 2048;
	let mut block_size = 128;

	let buffer = Buffer { size = 0, data = bitcast[&mut [i8]](0), device = 0 };
	let mut buffer_offset:i32 = 0;

	let ze = LevelZero {
		device_id = idx,
		grid_size = @|num| { grid_size = num; },
		block_size = @|bs| { block_size = bs; },
		warps_per_block = @|num| { block_size = num * warp_size; }
	};

	//let device_name = runtime_device_name(runtime_device(1, nvvm.device_id));
	//print_string(device_name); print_string("\n");

	Device[LevelZero] {
		platform = ze,
		device_id = runtime_device(5, ze.device_id),
		alloc = @|size| acc.alloc(size),
		root = @|| {
			let fixed_grid_size = grid_size;
			let fixed_block_size = block_size;

			Group {
				size = fixed_grid_size,
				subgroups = @|body| @|| {
					print_string("grid_size: "); print_i32(fixed_grid_size); print_string(" | block_size: "); print_i32(fixed_block_size); print_string("\n");
					for _ in acc.exec(( fixed_grid_size, 1, 1), (fixed_block_size, 1, 1)) {

						let idx = spv_levelzero_get_group_id()(0) as i32;
						let block = make_ze_block(idx, fixed_block_size);

						@body(idx, block)
					}
				},
				alloc = @|size| {
					let ptr = bitcast[&mut[u8]](&buffer.data(buffer_offset));
					//buffer_offset += size;
					ptr
				},
				barrier = @|| { acc.sync(); },
				num_subgroups = (fixed_grid_size + fixed_block_size - 1) / fixed_block_size,
				specific = GroupType::Grid,
				intrinsics = GroupIntrinsics {
					get_clock = Op[ (), i64]::Fn(get_kernel_time)
				}
			}
		}
	}
}


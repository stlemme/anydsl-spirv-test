/*
 * These require c_element_type to be set to f32!
 * Also, the tile size on Alchemist is different to the other backends:
 * The A and B matrices are loaded as 8x16 and 16x8 blocks, and the resulting fragment in C contains 8x8 values.
 * Consequently, tile_size_x and tile_size_y have to be lowered to 8!
 */

#[import(cc = "device", name = "spirv.coop_matrix.load")] fn spirv_matrix_load[T](&[u8], i32, i32) -> T;
#[import(cc = "device", name = "spirv.coop_matrix.mad")] fn spirv_matrix_mad[A, B, C](A, B, C) -> C;
#[import(cc = "device", name = "spirv.coop_matrix.store")] fn spirv_matrix_store[T](&mut [u8], T, i32, i32) -> ();

fn @spv_match_layout(addr_mode : AddrMode) -> i32 = match addr_mode {
    AddrMode::RowMajor => 0,
    AddrMode::ColMajor => 1
};

type_ext alchemist_acc_datatype   = { "OpTypeCooperativeMatrixKHR", "float", "3",  "8",  "8", "2", "SPV_KHR_cooperative_matrix" };
type_ext alchemist_mat_a_datatype = { "OpTypeCooperativeMatrixKHR",  "half", "3",  "8", "16", "0", "SPV_KHR_cooperative_matrix" };
type_ext alchemist_mat_b_datatype = { "OpTypeCooperativeMatrixKHR",  "half", "3", "16",  "8", "1", "SPV_KHR_cooperative_matrix" };

fn @alchemist_create_wmma(tile_size_k: i32) -> WMMA {
    let mut t_a : alchemist_mat_a_datatype;
    let mut t_b : alchemist_mat_b_datatype;
    let mut acc : alchemist_acc_datatype;

    let load_a = @|fragment_tensor : Tensor[a_element_type]| {
        spirv_matrix_load[alchemist_mat_a_datatype](bitcast[&[u8]](fragment_tensor.data), spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    let load_b = @|fragment_tensor : Tensor[b_element_type]| {
        spirv_matrix_load[alchemist_mat_b_datatype](bitcast[&[u8]](fragment_tensor.data), spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    let load_c = @|fragment_tensor : Tensor[c_element_type]| {
        spirv_matrix_load[alchemist_acc_datatype](bitcast[&[u8]](fragment_tensor.data), spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    let wmma = @|a_fragment : alchemist_mat_a_datatype, b_fragment : alchemist_mat_b_datatype, acc_fragment : alchemist_acc_datatype| {
        spirv_matrix_mad[alchemist_mat_a_datatype, alchemist_mat_b_datatype, alchemist_acc_datatype](a_fragment, b_fragment, acc_fragment)
    };

    let store_d = @|fragment_tensor : Tensor[c_element_type], acc_fragment : alchemist_acc_datatype| {
        spirv_matrix_store[alchemist_acc_datatype](bitcast[&mut [u8]](fragment_tensor.data), acc_fragment, spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    // TODO: this support f16 only / need to map different load&store for f32 support
    WMMA {
        tile_size_k = tile_size_k,
        load_a = @|a| { t_a = load_a(a); },
        load_b = @|b| { t_b = load_b(b); },
        load_c = @|c| { acc = load_c(c); },
        wmma = @||  { acc = wmma(t_a, t_b, acc); },
        store_d = @|d| { store_d(d, acc); },
    }
}


type_ext battlemage_acc_datatype   = { "OpTypeCooperativeMatrixKHR", "float", "3", "16", "16", "2", "SPV_KHR_cooperative_matrix" };
type_ext battlemage_mat_a_datatype = { "OpTypeCooperativeMatrixKHR",  "half", "3", "16", "16", "0", "SPV_KHR_cooperative_matrix" };
type_ext battlemage_mat_b_datatype = { "OpTypeCooperativeMatrixKHR",  "half", "3", "16", "16", "1", "SPV_KHR_cooperative_matrix" };

fn @battlemage_create_wmma(tile_size_k: i32) -> WMMA {
    let mut t_a : battlemage_mat_a_datatype;
    let mut t_b : battlemage_mat_b_datatype;
    let mut acc : battlemage_acc_datatype;

    let load_a = @|fragment_tensor : Tensor[a_element_type]| {
        spirv_matrix_load[battlemage_mat_a_datatype](bitcast[&[u8]](fragment_tensor.data), spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    let load_b = @|fragment_tensor : Tensor[b_element_type]| {
        spirv_matrix_load[battlemage_mat_b_datatype](bitcast[&[u8]](fragment_tensor.data), spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    let load_c = @|fragment_tensor : Tensor[c_element_type]| {
        spirv_matrix_load[battlemage_acc_datatype](bitcast[&[u8]](fragment_tensor.data), spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    let wmma = @|a_fragment : battlemage_mat_a_datatype, b_fragment : battlemage_mat_b_datatype, acc_fragment : battlemage_acc_datatype| {
        spirv_matrix_mad[battlemage_mat_a_datatype, battlemage_mat_b_datatype, battlemage_acc_datatype](a_fragment, b_fragment, acc_fragment)
    };

    let store_d = @|fragment_tensor : Tensor[c_element_type], acc_fragment : battlemage_acc_datatype| {
        spirv_matrix_store[battlemage_acc_datatype](bitcast[&mut [u8]](fragment_tensor.data), acc_fragment, spv_match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    };

    // TODO: this support f16 only / need to map different load&store for f32 support
    WMMA {
        tile_size_k = tile_size_k,
        load_a = @|a| { t_a = load_a(a); },
        load_b = @|b| { t_b = load_b(b); },
        load_c = @|c| { acc = load_c(c); },
        wmma = @||  { acc = wmma(t_a, t_b, acc); },
        store_d = @|d| { store_d(d, acc); },
    }
}

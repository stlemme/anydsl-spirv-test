
static ze_warp_size:i32 = 32;

fn ze_thread_intrinsics() = GroupIntrinsics {
};


fn ze_warp_intrinsics(tile_size_k: i32) = GroupIntrinsics {
	//barrier_any = Op[Accessor[u8],  u8]::Fn(nvvm_warp_barrier_any),
	//shuffle_i32 = Op[   (i32,i32), i32]::Fn(nvvm_warp_shuffle_i32)
	wmma = Op[   (), WMMA]::Fn(@|| alchemist_create_wmma(tile_size_k))
};

fn ze_block_intrinsics() = GroupIntrinsics {
	//barrier_any = Op[Accessor[u8], u8]::Fn(nvvm_block_barrier_any)
};


fn @make_ze_thread(_idx: i32) -> Group {
	Group {
		size = 1,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| {
			// cuda_threadfence()
		},
		subgroups = @|body| @|| {
			let idx = 0;
			let thread = make_ze_thread(idx);
			@body(idx, thread)
		},
		num_subgroups = 1,
		specific = GroupType::Thread,
		intrinsics = ze_thread_intrinsics()
	}
}


// TODO: slice a warp into sub warps

fn @make_ze_warp(_idx: i32, _num_warps_per_block: i32) -> Group {
	let tile_size_k = 16;

	Group {
		size = warp_size,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| { /* nvvm_warp_sync(0xFFFFFFFF) */ },
		subgroups = @|body| @|| {
			let idx = spv_levelzero_get_local_id()(0) as i32 % ze_warp_size;
			let thread = make_ze_thread(idx);
			@body(idx, thread)
		},
		num_subgroups = warp_size,
		specific = GroupType::Warp,
		intrinsics = ze_warp_intrinsics(tile_size_k)
	}
}

fn @reduce_any(group: Group, array: Accessor[bool]) -> bool {

	pe_info("reduce_any(group)", group.size);

	match group.intrinsics.barrier_any {
	
		Op[Accessor[bool], bool]::Fn(func) => func(array),
			
		_ => {
			let mut result = false;

			if group.size == 1 {

				pe_info("reduce_any(group)", 5);

				for i in range(0, array.len()) {
					result |= array.get(i);
				}

			} else {

				pe_info("reduce_any(group)", 6);

				for buf in shared_mem[bool](group, group.num_subgroups) {

					for idx, subgroup in subgroups(group) {
						let res = reduce_any(subgroup, make_partition(array, idx, group, subgroup));
						//if idx == 0 {
						buf.set(idx, res)
						//}
					}

					//result = reduce_any(group, buf);
					result = buf.get(0);
				}
			}

			result
		}
	}
}

fn @make_partition[T](array: Accessor[T], idx: i32, _group: Group, subgroup: Group) -> Accessor[T] {
	let offset = idx * subgroup.size;

	Accessor[T] {
		get = @|i| {
			array.get(offset + i)
		},
		set = @|i, val| {
			array.set(offset + i, val)
		}, 
		len = || subgroup.size
	}
}


fn @shared_mem[T](body: fn(Accessor[T])->()) -> fn(Group, i32)->() {

	@|group, size| {
		pe_info("shared_mem[T]() - group.size", group.size);
		pe_info("shared_mem[T]() - size", size);

		// TODO: pass down topology information
		let num_warps_per_block = 4; // (block_size + warp_size - 1) / warp_size;

		let array = match (group.specific) {
			GroupType::CUDAGrid(block_size) => {
				let mem_size = size * sizeof[T]() as i32;
				pe_info("shared_mem[T]() - alloc_cuda()", mem_size);
				let mem = group.alloc(mem_size);
				let ptr = bitcast[&mut[T]](mem);

				Accessor[T] {
					get = @|i| ptr(i),
					set = @|i, val| { ptr(i) = val },
					len = @|| size
				}
			},

			GroupType::CUDABlock => {
				let mem_size = size;
				pe_info("shared_mem[T]() - reserve_shared[T]()", mem_size);
				let ptr = reserve_shared[T](mem_size);
				//let ptr = bitcast[&mut addrspace(3)[T]](mem);

				Accessor[T] {
					get = @|i| ptr(i),
					set = @|i, val| { ptr(i) = val },
					len = @|| size
				}
			},

			GroupType::CUDAWarp => {
				let mem_size = num_warps_per_block * size;
				pe_info("shared_mem[T]() - reserve_shared[T]()", mem_size);
				let ptr = reserve_shared[T](mem_size);
				//let ptr = bitcast[&mut addrspace(3)[T]](mem);

				// TODO: may use bitmask for offset computation
				let idx = cuda_threadIdx_x() / warp_size;
				let offset = idx * warp_size;

				Accessor[T] {
					get = @|i| ptr(offset + i),
					set = @|i, val| { ptr(offset + i) = val },
					len = @|| size
				}

			},

			_ => {
				let mut value:T;

				Accessor[T] {
					get = @|_| value,
					set = @|_, val| { value = val },
					len = @|| 1
				}
			}
		};

		body(array)
	}
}





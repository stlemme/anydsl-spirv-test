fn @make_cuda_group(body: fn(Group)->()) = @|acc: Accelerator, size: i32, block: i32, accum_buffer_size: i32| {

	let g = (size, 1, 1);
	let b = (block, 1, 1);

	//let mut total:i32 = 0;

	let buffer = acc.alloc(accum_buffer_size as i64);

	for _ in acc.exec(g, b) {
		let mut buffer_offset:i32 = 0;

		let group = Group {
			size = size,
			//subgroups = @|body| @|| {
			//	let idx = cuda_blockIdx_x();
			//	let subgroup = make_cuda_block(acc, idx, block);
			//	@body(idx, subgroup)
			//},
			alloc = @|size| {
				let ptr = bitcast[&mut[u8]](&buffer.data(buffer_offset));
				buffer_offset += size;
				ptr
			},
			num_subgroups = (size + block - 1) / block,
			specific = GroupType::CUDAGrid(block),
			intrinsics = GroupIntrinsics { }
		};

		body(group)
	}
	
	release(buffer);
};

fn @cuda_pred(b: bool) -> i32 {
	if b { 1 } else { 0 }
}

fn @subgroups(body: fn(i32, Group)->()) -> fn(Group)->() {
	@|group| {
		let (idx, subgroup) = match (group.specific) {
			GroupType::CUDAGrid(block_size) => {
				let idx = cuda_blockIdx_x();
				let num_warps_per_block = (block_size + warp_size - 1) / warp_size;
				let block = Group { size = block_size,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					num_subgroups = num_warps_per_block, specific = GroupType::CUDABlock, intrinsics = GroupIntrinsics {
					//barrier_any = Op[Accessor[bool], bool]::Fn(@|pred| { cuda_block_sync_any(cuda_pred(pred.get(cuda_threadIdx_x()))) != 0 })
				} };

				(idx, block)
			},

			GroupType::CUDABlock => {
				let idx = cuda_threadIdx_x() / warp_size;
				let warp = Group { size = warp_size,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					num_subgroups = warp_size, specific = GroupType::CUDAWarp, intrinsics = GroupIntrinsics {
					/* barrier_any = Op[Accessor[bool], bool]::Fn(@|pred| {
						let tidx = cuda_laneid() as i32;
						let val = if tidx < pred.len() { pred.get(tidx) } else { false };
						cuda_warp_sync_any(0xFFFFFFFF, cuda_pred(val)) != 0
					}) */
				} };

				(idx, warp)
			},

			GroupType::CUDAWarp => {
				let idx = cuda_laneid() as i32;
				let thread = Group { size = 1,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					num_subgroups = 1, specific = GroupType::CUDAThread, intrinsics = GroupIntrinsics { } };

				(idx, thread)
			},

			_ => {
				(0, Group { size = 1,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					num_subgroups = 1, specific = GroupType::CUDAThread, intrinsics = GroupIntrinsics { } })
			}
		};

		body(idx, subgroup)
	}
}



			if idx == 0 {
				result = res
			}
		} */
		
		// barrier
		
		//let buf = Accessor[bool] { get = |i| { array.get(i) == element }, set = |_, _| { }, len = array.len };
		//result = if reduce_any(group, buf) { 23 } else { 47 };

		result

		/*
		with group.shared[bool](group.num_subgroups) as buf {
			for idx, subgroup in subgroups(group) {
				buf(idx) = find(subgroup, make_view(array, idx, group, subgroup), element);
			}

			group.barrier();

			reduce_any(group, buf)
		}
		*/
	}
}


fn @find_element_prgmodA(acc: Accelerator, data: Accessor[data_type], elem: data_type, num: i32, bs: i32) -> i32 {
	let result_cpu = alloc_cpu(sizeof[i32]());
	let result_dev = acc.alloc(sizeof[i32]());

	let p_result_cpu = bitcast[&mut addrspace(0) i32](result_cpu.data);
	let p_result_dev = bitcast[&mut addrspace(1) [i32]](result_dev.data);

	*p_result_cpu = 0;
	copy(result_cpu, result_dev);

	//let g = (num, 1, 1);
	//let b = (bs, 1, 1);

	let scratchpad_size = (num / bs) * sizeof[i32]() as i32;

	for group in make_cuda_group(acc, num, bs, scratchpad_size) {
		let p_result = &mut p_result_dev(0);

		//*p_result = prgmod_find_element(group, data, elem);

		let buf = Accessor[u8] { get = |i| { if data.get(i) == elem { 1 } else { 0 } }, set = |_,_| { }, len = data.len };

		// blocks
		for idx, subgroup in subgroups(group) {
			if idx == 0 {
				// warps of first block
				for idx, subgroup in subgroups(group) {
					if idx == 0 {
						*p_result = if reduce_any(subgroup, buf) != 0 { 23 } else { 47 };
					}
				}
			}
		}
	}

	copy(result_dev, result_cpu);
	let result = *p_result_cpu;

	release(result_dev);
	release(result_cpu);

	result
}


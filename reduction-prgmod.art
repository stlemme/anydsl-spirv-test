

fn @reduce_any(group: Group, array: Accessor[u8]) -> u8 {

	pe_info("reduce_any(group)", group.size);

	match group.intrinsics.barrier_any {

		// utilize hardware intrinsic if available
		Op[Accessor[u8], u8]::Fn(func) => func(array),

		_ => {
			let mut result:u8 = 0;

			if group.size == 1 {

				pe_info("reduce_any(group)", 5);

				for i in range(0, array.len()) {
					result = result | array.get(i);
				}

			} else {

				pe_info("reduce_any(group)", 6);

				// allocate memory that is shared accross all subgroups to collect intermediate results
				for buf in shared_mem[u8](group, group.num_subgroups) {

					// each subgroup processes a partition of array
					for idx, subgroup in subgroups(group) {

						buf.set(idx, 0);
					
						if subgroup.size > 1 {

							let mut res:u8 = 0;
							// subgroups may need to process more than one partition
							for i in range_step(idx, array.len(), subgroup.size) {
								res |= reduce_any(subgroup, make_partition(array, i, group, subgroup));
							}
							buf.set(idx, res);

						} else {

							// first thread in group does reduction
							if idx == 0 {
								let res = reduce_any(subgroup, array);
								buf.set(idx, res);
							}

						}
					}

					// TODO: this may wait forever when syncing warps inside a block with warp intrinsics available
					group.barrier();

					// further reduction of intermediate results
					for idx, subgroup in subgroups(group) {
						if idx == 0 {
							result = reduce_any(subgroup, buf);
						}
					}
					//result = reduce_any(group, buf);
				}
			}

			result
		}
	}
}


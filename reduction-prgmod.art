
enum GroupType {
	CUDAGrid(i32),
	CUDABlock,
	CUDAWarp,
	CUDAThread
}

/*
struct CUDAGrid   { platform: i32, block_size: i32 }
struct CUDABlock  { platform: i32 }
struct CUDAWarp   { platform: i32 }
struct CUDAThread { platform: i32 }
*/

enum Op[S, T] {
	Fn(fn(S)->T),
	Generic
}

struct GroupIntrinsics {
	barrier_any: Op[Accessor[bool], bool] = Op[Accessor[bool], bool]::Generic
	//wmma_load:
	//wmma_mma:
	//wmma_store:
}

struct Group {
	size: i32,										// total num threads
	//subgroups: fn(fn(i32, Group)->()) -> fn()->(),	// split group into subgroups according to hardware topology
	num_subgroups: i32,								// total num subgroups
	//barrier: fn() -> (),
	alloc: fn(i32) -> &mut[u8],						// allocate/reserve memory
	specific: GroupType,
	intrinsics: GroupIntrinsics
}


fn @div_up(num: i32, div: i32) -> i32 {
	let blocks = num / div;
	if num % div == 0 {
		blocks
	} else {
		blocks + 1
	}
}


static warp_size:i32 = 32;


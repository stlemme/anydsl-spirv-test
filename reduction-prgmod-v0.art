


struct Group {
	size: i32,										// total num threads
	subgroups: fn(fn(i32, Group&)->()) -> fn()->(),	// split group into subgroups according to hardware topology
	num_subgroups: i32,								// total num subgroups
	//barrier: fn() -> (),
	//shared: fn() -> &mut[u8]						// allocate/reserve memory
}


fn @div_up(num: i32, div: i32) -> i32 {
	let blocks = num / div;
	if num % div == 0 {
		blocks
	} else {
		blocks + 1
	}
}


static warp_size:i32 = 32;


fn make_cuda_thread(acc: Accelerator, _idx: i32) = Group {
	size = 1,
	subgroups = @|body| @|| {
		let idx = 0;
		let subgroup = make_cuda_thread(acc, idx);
		@body(idx, subgroup)
	},
	num_subgroups = 1
};

// TODO: slice a warp into sub warps

fn make_cuda_warp(acc: Accelerator, _idx: i32, _size: i32) = Group {
	size = warp_size,
	subgroups = @|body| @|| {
		let idx = cuda_laneid();
		let subgroup = make_cuda_thread(acc, idx);
		@body(idx, subgroup)
	},
	num_subgroups = warp_size
};

// TODO: slice a block into subset of its warps

fn make_cuda_block(acc: Accelerator, _idx: i32, size: i32) -> Group {
	let num_warps_per_block = @|| (size + warp_size - 1) / warp_size;
	Group {
		size = size,
		subgroups = @|body| @|| {
			let idx = cuda_threadIdx_x() / warp_size;
			let subgroup = make_cuda_warp(acc, idx);
			@body(idx, subgroup)
		},
		num_subgroups = num_warps_per_block
	}
}

fn make_cuda_group(body: fn(Group)->()) = @|acc: Accelerator, size: i32, block: i32| {

	let g = (size, 1, 1);
	let b = (block, 1, 1);

	for _ in acc.exec(g, b) {
		let group = Group {
			size = size,
			subgroups = @|body| @|| {
				let idx = cuda_blockIdx_x();
				let subgroup = make_cuda_block(acc, idx, block);
				@body(idx, &subgroup)
			},
			num_subgroups = div_up(size, block)
		};

		body(group)
	}
};


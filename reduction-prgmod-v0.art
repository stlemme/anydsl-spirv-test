fn make_partition(array: Accessor, idx: i32, _group: Group, subgroup: Group) -> Accessor {
	let offset = idx * subgroup.size;

	@|i| {
		array(offset + i)
	}
}


fn prgmod_find_element(group: Group, array: Accessor, element: data_type) -> i32 {
	if group.size == 1 {

		if array(0) == element { 1 } else { 0 }

	} else {
		let mut result:i32 = 42;

		for idx, subgroup in group.subgroups() {
			let res = prgmod_find_element(subgroup, make_partition(array, idx, group, subgroup), element);
			if idx = 0 {
				result = res
			}
		}

		result

		/*
		with group.shared[bool](group.num_subgroups) as buf {
			for idx, subgroup in group.subgroups() {
				buf(idx) = find(subgroup, make_view(array, idx, group, subgroup), element);
			}

			group.barrier();

			reduce_any(group, buf)
		}
		*/
	}
}


fn find_element_prgmodA(acc: Accelerator, data: Accessor, elem: data_type, num: i32, bs: i32) -> i32 {
	let result_cpu = alloc_cpu(sizeof[i32]());
	let result_dev = acc.alloc(sizeof[i32]());

	let p_result_cpu = bitcast[&mut addrspace(0) i32](result_cpu.data);
	let p_result_dev = bitcast[&mut addrspace(1) [i32]](result_dev.data);

	*p_result_cpu = 0;
	copy(result_cpu, result_dev);

	//let g = (num, 1, 1);
	//let b = (bs, 1, 1);

	for group in make_cuda_group(acc, num, bs) {
		let p_result = &mut p_result_dev(0);

		*p_result = prgmod_find_element(group, data, elem);
	}

	copy(result_dev, result_cpu);
	let result = *p_result_cpu;

	release(result_dev);
	release(result_cpu);

	result
}

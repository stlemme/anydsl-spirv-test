
type data_type = i32;



#[export]
fn main() -> i32 {

        let acc = cuda_accelerator(0);

        let num = 1024;
        let bs  =  128;
        let elem1 = 142;
        let elem2 = -142;

        let buf = acc.alloc(num as i64 * sizeof[data_type]());
        let ptr = bitcast[&mut addrspace(1) [data_type]](buf.data);

        let g = (num, 1, 1);
        let b = (bs, 1, 1);

        for item in acc.exec(g, b) {
            if item.gidx() < num {
                let idx = item.gidx();
                ptr(idx) = idx;
            }
        }

        let data = Accessor[data_type] { get = |i| ptr(i), set = |_,_| { }, len = || num };

        //let find_element = find_element_refA;
        //let find_element = find_element_refB;
        //let find_element = find_element_refC;
        let find_element = find_element_prgmodA;
        //let find_element = find_element_prgmodB;

        let result_ref1 = find_element(acc, data, elem1, num, bs);
        let result_ref2 = 81; //find_element(acc, data, elem2, num, bs);

        release(buf);

        print_string("Result (reference): ");
        print_i32(result_ref1);
        print_string(" / ");
        print_i32(result_ref2);
        print_string("\n");

        if (result_ref1 == 1) && (result_ref2 == 0) {
            0
        } else {
            -1
        }
}


enum GroupType {
	CUDAGrid(i32),
	CUDABlock,
	CUDAWarp,
	CUDAThread
}


struct Intrinsics {
	barrier_any: fn(bool) -> bool
}

struct Group {
	size: i32,										// total num threads
	//subgroups: fn(fn(i32, Group)->()) -> fn()->(),	// split group into subgroups according to hardware topology
	num_subgroups: i32,								// total num subgroups
	//barrier: fn() -> (),
	//shared: fn() -> &mut[u8]						// allocate/reserve memory
	specific: GroupType,
	intrinsics: Intrinsics
}


fn @div_up(num: i32, div: i32) -> i32 {
	let blocks = num / div;
	if num % div == 0 {
		blocks
	} else {
		blocks + 1
	}
}


static warp_size:i32 = 32;


fn make_cuda_group(body: fn(Group)->()) = @|acc: Accelerator, size: i32, block: i32| {

	let g = (size, 1, 1);
	let b = (block, 1, 1);

	for _ in acc.exec(g, b) {
		let group = Group {
			size = size,
			//subgroups = @|body| @|| {
			//	let idx = cuda_blockIdx_x();
			//	let subgroup = make_cuda_block(acc, idx, block);
			//	@body(idx, subgroup)
			//},
			num_subgroups = div_up(size, block),
			specific = GroupType::CUDAGrid(block)
		};

		body(group)
	}
};


fn subgroups(body: fn(i32, Group)->()) -> fn(Group)->() {
	@|group| {
		let (idx, subgroup) = match (group.specific) {
			GroupType::CUDAGrid(block_size) => {
				let idx = cuda_blockIdx_x();
				let num_warps_per_block = (block_size + warp_size - 1) / warp_size;
				let block = Group { size = block_size, num_subgroups = num_warps_per_block, specific = GroupType::CUDABlock };

				(idx, block)
			},

			GroupType::CUDABlock => {
				let idx = cuda_threadIdx_x() / warp_size;
				let warp = Group { size = warp_size, num_subgroups = warp_size, specific = GroupType::CUDAWarp };

				(idx, warp)
			},

			GroupType::CUDAWarp => {
				let idx = cuda_laneid() as i32;
				let thread = Group { size = 1, num_subgroups = 1, specific = GroupType::CUDAThread };

				(idx, thread)
			},

			_ => {
				(0, Group { size = 1, num_subgroups = 1, specific = GroupType::CUDAThread })
			}
		};

		body(idx, subgroup)
	}
}


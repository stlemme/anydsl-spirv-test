fn make_partition[T](array: Accessor[T], idx: i32, _group: Group, subgroup: Group) -> Accessor[T] {
	let offset = idx * subgroup.size;

	Accessor[T] {
		get = @|i| {
			array.get(offset + i)
		},
		len = || subgroup.size
	}
}


fn @prgmod_find_element(group: Group, array: Accessor[data_type], element: data_type) -> i32 {
	if group.size == 1 {

		if array.get(0) == element { 1 } else { 0 }


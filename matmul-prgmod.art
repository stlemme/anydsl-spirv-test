// medium/large

static N = 512;
static M = 1024;
static K = 256;

// increase for reliable measurements,
// but may break results when using read-write-buffers
static num_bench_iter = 7;


static alayout = AddrMode::RowMajor;
static blayout = AddrMode::ColMajor;
static clayout = AddrMode::RowMajor;



static tile_size_x = 16;
static tile_size_y = 16;
static tile_size_k = 16;


fn @matrix_multiplyA(
    group: Group,
    a : Tensor[a_element_type],
    b : Tensor[b_element_type],
    c : Tensor[c_element_type],
    d : Tensor[c_element_type]
) -> () {

    let m = a.y_dim;
    let n = b.x_dim;
    //assert(a.x_dim == b.y_dim);
    let k = a.x_dim;

    let num = m*n;
    let bs = 128;

	let scratchpad_size = 0; //(num / bs) * sizeof[i32]() as i32;


    // blocks
    for pbidx, block in subgroups(group) {

        for bidx in range_step(pbidx, num/block.size, group.num_subgroups) {

	        // warps
	        for widx, warp in subgroups(block) {

                // threads
		        for tidx, _thread in subgroups(warp) {

                    let gidx = bidx*block.size + widx*warp.size + tidx;

                    let y = gidx / n;
                    let x = gidx % n;

                    let mut rv = 0 : f32;

                    for i in range(0, k) {
                        let av = tensor_read[f32, a_element_type](i, y, a);
                        let bv = tensor_read[f32, b_element_type](x, i, b);

                        rv += av * bv;
                    }

                    let cv = tensor_read[f32, c_element_type](x, y, c);

                    tensor_write[f32, c_element_type](x, y, d, (cv + rv));
                }

            }

        }
    }
}

fn @matrix_multiplyAv2(
    group: Group,
    a : Tensor[a_element_type],
    b : Tensor[b_element_type],
    c : Tensor[c_element_type],
    d : Tensor[c_element_type]
) -> () {

    let m = a.y_dim;
    let n = b.x_dim;
    //assert(a.x_dim == b.y_dim);
    let k = a.x_dim;

    let num = m*n;

	for tidx, _thread in each_thread(group) {

        for gidx in range_step(tidx, num, group.size) {

            let y = gidx / n;
            let x = gidx % n;

            let mut rv = 0 : f32;

            for i in range(0, k) {
                let av = tensor_read[f32, a_element_type](i, y, a);
                let bv = tensor_read[f32, b_element_type](x, i, b);

                rv += av * bv;
            }

            let cv = tensor_read[f32, c_element_type](x, y, c);

            tensor_write[f32, c_element_type](x, y, d, (cv + rv));
        }
    }
}


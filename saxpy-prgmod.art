

type element_type = f32;

static N = 4096;
// increase for reliable measurements,
// but may break results when using read-write-buffers
static num_bench_iter = 1;

fn saxpy(
    group: Group,
    a: element_type,
    x: Accessor[element_type],
    y: Accessor[element_type]
) -> () {

	for idx, _thread in each_thread(group) {
		let i = idx;
		let n = y.len();
		// this covers only the case we have more threads in our group than work items
		if (i < n) {
			y.set(i, a * x.get(i) + y.get(i));
		}
	}

}

fn better_saxpy_element_type(
    group: Group,
    a: element_type,
    x: Accessor[element_type],
    y: Accessor[element_type]
) -> () {

	for idx, _thread in each_thread(group) {
		let i = idx;
		let n = y.len();
		// each thread may process multiple work items
		for j in range_step(i, n, group.size) {
			y.set(j, a * x.get(j) + y.get(j));
		}
	}

}

fn better_saxpy_basic[T](
    group: Group,
    a: T,
    x: Accessor[T],
    y: Accessor[T],
    implicit tt: TypeTraits[T]
) -> () {

	for idx, _thread in each_thread(group) {
		let i = idx;
		let n = y.len();
		// each thread may process multiple work items
		for j in range_step(i, n, group.size) {
            let ax = tt.mul(a, x.get(j));
			y.set(j, tt.add(ax, y.get(j)));
		}
	}

}

fn better_saxpy[T](
    group: Group,
    a: T,
    x: Accessor[T],
    y: Accessor[T],
    implicit tt: TypeTraits[T]
) -> () {

	for i in each_element_in_domain[T](y, group) {
        let ax = tt.mul(a, x.get(i));
		y.set(i, tt.add(ax, y.get(i)));
	}

}


fn saxpy_naive (
    a : element_type,
    x : Accessor[element_type],
    y : Accessor[element_type]
) -> () {

    let outer_loop = @|body:fn(i32)->()| @|b:i32, e:i32| range(body)(b, e);
    //let outer_loop = @|body:fn(i32)->()| @|b:i32, e:i32| parallel(body)(0, b, e);

    for i in outer_loop(0, y.len()) {
        y.set(i, a * x.get(i) + y.get(i));
    }
}

#[export]
fn entry_fn() -> i32 {

    let dev = nvvm_device(0);
    //let dev = cpu_device(0);

    let group = make_group(dev);

    let acc_saxpy = @|a : element_type, x : Accessor[element_type], y : Accessor[element_type]| {
        better_saxpy[element_type](group, a, x, y);
    };
	let ref_saxpy = saxpy_naive;

    // Produce data set on host
    let x_cpu_buffer = alloc_cpu(sizeof[element_type]() * N as i64);
    let y_cpu_buffer = alloc_cpu(sizeof[element_type]() * N as i64);
    let r_cpu_buffer = alloc_cpu(sizeof[element_type]() * N as i64);

    let x_cpu_array = make_array_from_buffer[element_type](x_cpu_buffer);
    let y_cpu_array = make_array_from_buffer[element_type](y_cpu_buffer);
    let r_cpu_array = make_array_from_buffer[element_type](r_cpu_buffer);

    for n in range(0, N) { x_cpu_array.set(n, random_float[element_type]()); }
    for n in range(0, N) { y_cpu_array.set(n, random_float[element_type]()); }

    let a_value = random_float[element_type]();

    // Copy data to device
    // TODO: this shall actually depend on group
    let x_dev_buffer = dev.alloc(sizeof[element_type]() * N as i64);
    let y_dev_buffer = dev.alloc(sizeof[element_type]() * N as i64);

    copy(x_cpu_buffer, x_dev_buffer);
    copy(y_cpu_buffer, y_dev_buffer);
    copy(y_cpu_buffer, r_cpu_buffer);

    let x_dev_array = make_array_from_buffer[element_type](x_dev_buffer);
    let y_dev_array = make_array_from_buffer[element_type](y_dev_buffer);

    print_string("prgmod saxpy:\n");
    //group.barrier();
    //let acc_start = get_kernel_time();

    for benchmark(group, num_bench_iter) {
        acc_saxpy(a_value, x_dev_array, y_dev_array);
    }

    //group.barrier();
    //let acc_end = get_kernel_time();
    //print_string("Done!\n");
    //if (acc_end - acc_start > 0) {
    //    print_string("Took ");
    //    print_i64(acc_end - acc_start);
    //    print_string("us\n");
    //}

    // Fetch result
    copy(y_dev_buffer, y_cpu_buffer);

    // Ref implementation
    //print_string("CPU variant:\n");
    let cpu_start = get_micro_time();
    ref_saxpy(a_value, x_cpu_array, r_cpu_array);
    let cpu_end = get_micro_time();
    //print_string("Done!\n");
    //if (cpu_end - cpu_start > 0) {
    //    print_string("Took ");
    //    print_i64(cpu_end - cpu_start);
    //    print_string("us\n");
    //}

    for i in range(0, r_cpu_array.len()) {
        r_cpu_array.set(i, r_cpu_array.get(i) - y_cpu_array.get(i));
    }

    release(x_dev_buffer);
    release(y_dev_buffer);

    release(x_cpu_buffer);
    release(y_cpu_buffer);

    let mut max_error = 0 as f32;
    for i in range(0, r_cpu_array.len()) {
        max_error = cpu_intrinsics.fmaxf(max_error, fabs[element_type](r_cpu_array.get(i)));
    }

    release(r_cpu_buffer);

    print_string("Max error: ");
    print_f32(max_error);
    print_string("\n");

    if (max_error < (0.01 as f32)) {
        0
    } else {
        1
    }
}

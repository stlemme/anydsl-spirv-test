	fn saxpy(group: Group, a: f32, x: Accessor[f32], y: Accessor[f32]) -> () {

		for idx, thread in threads(group) {
			let i = idx;
			let n = y.len();
			// this covers only the case we have more threads in our group than work items
			if (i < n) {
				y.set(i, a * x.get(i) + y.get(i));
			}
		}

	}


	fn better_saxpy[T](group: Group, a: T, x: Accessor[T], y: Accessor[T]) -> () {

		for idx, thread in threads(group) {
			let i = idx;
			let n = y.len();
			// each thread may process multiple work items
			for j in range_step(i, n, group.size) {
				y.set(j, a * x.get(j) + y.get(j));
			}
		}

	}

	fn better_saxpy[T](group: Group, a: T, x: Accessor[T], y: Accessor[T]) -> () {

		for idx in each_element_in_domain(y, group) {
			let i = idx;
			y.set(i, a * x.get(i) + y.get(i));
		}

	}


	fn saxpy[G](group: G, a: f32, x: Accessor[f32], y: Accessor[f32], implicit conv: ConvertToGroup[G]) -> () {

		for idx, thread in threads(conv.convert(group)) {
			let i = idx;
			let n = y.len();
			// this covers only the case we have more threads in our group than work items
			if (i < n) {
				y.set(i, a * x.get(i) + y.get(i));
			}
		}

	}


	fn my_prgmod_algo_A(group: Group, a: f32, x: Accessor[f32], y: Accessor[f32]) -> () {

		for idx, subgroup in subgroups(group) {
			// do something per subgroup

			// utilize better_saxpy() with a subgroup - no matter of subgroup's actual size
			better_saxpy[f32](subgroup, a, x, y);

		}

	}



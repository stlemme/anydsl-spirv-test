
type data_type = i32;



#[export]
fn main() -> i32 {

        let acc = cuda_accelerator(0);

        let num = 1024;
        let bs  =  128;

        let buf = acc.alloc(num as i64 * sizeof[data_type]());
        let ptr = bitcast[&mut addrspace(1) [data_type]](buf.data);

        let g = (num, 1, 1);
        let b = (bs, 1, 1);

        for item in acc.exec(g, b) {
            if item.gidx() < num {
                let idx = item.gidx();
                ptr(idx) = idx;
            }
        }

        let data = Accessor[data_type] { get = |i| ptr(i), set = |_,_| { }, len = || num };

        let reduce_sum = reduce_sumA;

        let result_ref = reduce_sum(acc, data, num, bs);

        release(buf);

        print_string("Result (reference): ");
        print_i32(result_ref);
        print_string("\n");

        if result_ref == (num*(num-1)/2) {
            0
        } else {
            -1
        }
}

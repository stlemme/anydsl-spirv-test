
fn test_prgmod_reduction(grid: Group, buf: Accessor[u8], result: fn(i32)->()) -> ()
{
	// single warp

	// blocks
	for idx, block in subgroups(grid) {
		// first block
		if idx == 0 {
			// warps
			for idx, warp in subgroups(block) {
				// first warp
				if idx == 0 {
					if reduce_any(warp, buf) != 0 {
						result(23)
					} else {
						result(47)
					}
				}
			}
		}
	}
}

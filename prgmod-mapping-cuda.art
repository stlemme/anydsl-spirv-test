
static warp_size:i32 = 32;


fn @make_cuda_thread(_idx: i32) -> Group {
	Group {
		size = 1,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| {
			// cuda_threadfence()
		},
		subgroups = @|body| @|| {
			let idx = 0;
			let thread = make_cuda_thread(idx);
			@body(idx, thread)
		},
		num_subgroups = 1,
		specific = GroupType::CUDAThread,
		intrinsics = GroupIntrinsics { }
	}
}

fn @cuda_warp_barrier_any(pred:Accessor[u8]) -> u8 {
	let tidx = cuda_laneid() as i32;
	let mut result:u8 = 0;
	for i in range_step(tidx, pred.len(), warp_size) {
		let val = if i < pred.len() { pred.get(i) } else { 0 };
		result |= cuda_warp_sync_any(0xFFFFFFFF, val as i32) as u8
		//cuda_warp_sync_any(0xFFFFFFFF, pred.get(tidx) as i32) as u8
	}
	result
}

// TODO: scope implementation and use group instance of warp to check bounds, etc.
fn @cuda_warp_shuffle_i32(value: i32, src_lane: i32) -> i32 {
	let membermask = 0xFFFFFFFF as u32;
	let width = warp_size;
	cuda_warp_shfl_i32(membermask, value, src_lane, width)
}

// TODO: slice a warp into sub warps

fn @make_cuda_warp(_idx: i32, _num_warps_per_block: i32) -> Group {
	Group {
		size = warp_size,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| { cuda_warp_sync(0xFFFFFFFF) },
		subgroups = @|body| @|| {
			let idx = cuda_laneid() as i32;
			let thread = make_cuda_thread(idx);
			@body(idx, thread)
		},
		num_subgroups = warp_size,
		specific = GroupType::CUDAWarp,
		intrinsics = GroupIntrinsics {
			barrier_any = Op[Accessor[u8],  u8]::Fn(cuda_warp_barrier_any),
			shuffle_i32 = Op[   (i32,i32), i32]::Fn(cuda_warp_shuffle_i32)
		}
	}
}

fn @cuda_block_barrier_any(pred:Accessor[u8]) -> u8 {
	let tidx = cuda_threadIdx_x();
	let mut result:u8 = 0;
	for i in range_step(tidx, pred.len(), warp_size) {
		let val = if i < pred.len() { pred.get(i) } else { 0 };
		result |= cuda_block_sync_any(val as i32) as u8
	}
	result
}

fn @make_cuda_block(_idx: i32, block_size: i32) -> Group {
	let num_warps_per_block = (block_size + warp_size - 1) / warp_size;

	Group {
		size = block_size,
		alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
		barrier = @|| { cuda_block_sync() },
		subgroups = @|body| @|| {
			let idx = cuda_threadIdx_x() / warp_size;
			let warp = make_cuda_warp(idx, num_warps_per_block);
			@body(idx, warp)
		},
		num_subgroups = num_warps_per_block,
		specific = GroupType::CUDABlock,
		intrinsics = GroupIntrinsics {
			barrier_any = Op[Accessor[u8], u8]::Fn(cuda_block_barrier_any)
		}
	}
}


fn @make_cuda_group(body: fn(Group)->()) = @|acc: Accelerator, grid_size: i32, block_size: i32, accum_buffer_size: i32| {

	let g = ( grid_size, 1, 1);
	let b = (block_size, 1, 1);

	let num_blocks = (grid_size + block_size - 1) / block_size;

	//let mut total:i32 = 0;

	let buffer = acc.alloc(accum_buffer_size as i64);

	for _ in acc.exec(g, b) {
		let mut buffer_offset:i32 = 0;

		let group = Group {
			size = grid_size,
			subgroups = @|body| @|| {
				let idx = cuda_blockIdx_x();
				let block = make_cuda_block(idx, block_size);
				@body(idx, block)
			},
			alloc = @|size| {
				let ptr = bitcast[&mut[u8]](&buffer.data(buffer_offset));
				buffer_offset += size;
				ptr
			},
			barrier = @|| { /* acc.sync() */ },
			num_subgroups = num_blocks,
			specific = GroupType::CUDAGrid(block_size),
			intrinsics = GroupIntrinsics { }
		};

		body(group)
	}
	
	release(buffer);
};

fn @cuda_pred(b: bool) -> i32 {
	if b { 1 } else { 0 }
}

type SubGroup = Group;

fn @subgroups(body: fn(i32, SubGroup)->()) -> fn(Group)->() {
	@|group| {

		let (idx, subgroup) = match (group.specific) {
			GroupType::CUDAGrid(block_size) => {
				let idx = cuda_blockIdx_x();
				let num_warps_per_block = (block_size + warp_size - 1) / warp_size;
				let block = Group { size = block_size,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| { cuda_block_sync() },
					subgroups = @|_body| @|| {

					},
					num_subgroups = num_warps_per_block, specific = GroupType::CUDABlock,
					intrinsics = GroupIntrinsics {
						barrier_any = Op[Accessor[u8], u8]::Fn(cuda_block_barrier_any)
					}
				};

				(idx, block)
			},

			GroupType::CUDABlock => {
				let idx = cuda_threadIdx_x() / warp_size;
				let warp = Group { size = warp_size,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| cuda_warp_sync(0xFFFFFFFF),
					subgroups = @|_body| @|| {

					},
					num_subgroups = warp_size, specific = GroupType::CUDAWarp,
					intrinsics = GroupIntrinsics {
						barrier_any = Op[Accessor[u8], u8]::Fn(cuda_warp_barrier_any),
						shuffle_i32 = Op[   (i32,i32), i32]::Fn(cuda_warp_shuffle_i32)
					}
				};

				(idx, warp)
			},

			GroupType::CUDAWarp => {
				let idx = cuda_laneid() as i32;
				let thread = Group { size = 1,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| {
						// cuda_threadfence()
					},
					subgroups = @|_body| @|| {

					},
					num_subgroups = 1, specific = GroupType::CUDAThread, intrinsics = GroupIntrinsics { } };

				(idx, thread)
			},

			_ => {
				(0, Group { size = 1,
					alloc = |size| { let ptr = reserve_shared[u8](size); bitcast[&mut[u8]](ptr) },
					barrier = @|| { },
					subgroups = @|_body| @|| {

					},
					num_subgroups = 1, specific = GroupType::CUDAThread, intrinsics = GroupIntrinsics { } })
			}
		};

		body(idx, subgroup)


		//let subgroup_scope = group.subgroups(@|idx, subgroup| @body(idx, *subgroup));
		//subgroup_scope()
	}
}

fn @shared_mem[T](body: fn(Accessor[T])->()) -> fn(Group, i32)->() {

	@|group, size| {
		pe_info("shared_mem[T]() - group.size", group.size);
		pe_info("shared_mem[T]() - size", size);

		// TODO: pass down topology information
		let num_warps_per_block = 4; // (block_size + warp_size - 1) / warp_size;

		let array = match (group.specific) {
			GroupType::CUDAGrid(_block_size) => {
				let size_type = sizeof[T]() as i32;
				let mem_size = size * if size_type > 1 { size_type } else { 1 };
				pe_info("shared_mem[T]() - alloc_cuda()", mem_size);
				let mem = group.alloc(mem_size);
				let ptr = bitcast[&mut[T]](mem);

				Accessor[T] {
					get = @|i| ptr(i),
					set = @|i, val| { ptr(i) = val },
					len = @|| size
				}
			},

			GroupType::CUDABlock => {
				let mem_size = size;
				pe_info("shared_mem[T]() - reserve_shared[T]()", mem_size);
				let ptr = reserve_shared[T](mem_size);
				//let ptr = bitcast[&mut addrspace(3)[T]](mem);

				Accessor[T] {
					get = @|i| ptr(i),
					set = @|i, val| { ptr(i) = val },
					len = @|| size
				}
			},

			GroupType::CUDAWarp => {
				let mem_size = num_warps_per_block * size;
				pe_info("shared_mem[T]() - reserve_shared[T]()", mem_size);
				let ptr = reserve_shared[T](mem_size);
				//let ptr = bitcast[&mut addrspace(3)[T]](mem);

				// TODO: may use bitmask for offset computation
				let idx = cuda_threadIdx_x() / warp_size;
				let offset = idx * warp_size;

				Accessor[T] {
					get = @|i| ptr(offset + i),
					set = @|i, val| { ptr(offset + i) = val },
					len = @|| size
				}

			},

			_ => {
				let mut value:T;

				Accessor[T] {
					get = @|_| value,
					set = @|_, val| { value = val },
					len = @|| 1
				}
			}
		};

		body(array)
	}
}

